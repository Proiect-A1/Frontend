# Copiaza acest fisier in .env.local (gitignored) si completeaza valorile pentru dev local.
# In CI/CD (deploy pe VM), aceste valori vin din GitHub Actions secrets/variables -
# vezi .github/workflows/deploy.yml si prod-deploy.yml.

# URL-ul backend-ului, folosit doar in build-uri non-Docker (vite.config.ts are deja
# un proxy /api -> localhost:8080 in dev). Optional local.
# VITE_API_URL=/api

# Cloudflare Access Service Token, necesar ca request-urile catre /api sa treaca de
# firewall-ul CF Access din fata backend-ului. Cere-le echipei de infra/Backend valorile.
VITE_CF_ACCESS_CLIENT_ID=
VITE_CF_ACCESS_CLIENT_SECRET=

# URL public al Cloudflare Worker din cloudflare-worker/ care proxiaza catre OpenRouter
# (tine cheia OpenRouter server-side, nu in bundle-ul frontend-ului). Vezi
# cloudflare-worker/README.md pentru cum il deploiezi. ATENTIE: e <worker>.<subdomeniul
# de cont>.workers.dev, nu doar <worker>.workers.dev - verifica cu `wrangler deploy`.
VITE_AI_PROXY_URL=https://fiicoder-ai-proxy.fiicoder-ai-proxy.workers.dev
