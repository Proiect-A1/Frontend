# Inclus de /etc/nginx/nginx.conf in contextul http.
# Configuratia este pentru containerul intern de nginx care serveste SPA-ul React
# si proxiaza /api/ catre backend.
#
# E un TEMPLATE (nu un .conf direct): imaginea oficiala nginx:alpine ruleaza
# automat envsubst pe orice fisier din /etc/nginx/templates/*.template la
# pornirea containerului si scrie rezultatul in /etc/nginx/conf.d/, inlocuind
# doar variabilele care chiar exista ca variabile de mediu (deci $uri, $host,
# $remote_addr etc. - variabile proprii nginx, nu de mediu - raman neatinse).
# ${BACKEND_HOST} vine din ENV-ul din Dockerfile. Implicit "dev-backend" -
# intentionat, atat pt. dev cat si pt. prod (vezi README.md, sectiunea Deploy).
# Poate fi suprascris per-container din docker-compose.yml daca vreodata se
# separa mediile pentru adevarat.

gzip on;
gzip_comp_level 6;
gzip_min_length 512;
gzip_proxied any;
gzip_vary on;
gzip_types
    text/plain
    text/css
    text/javascript
    application/javascript
    application/json
    application/xml
    application/wasm
    image/svg+xml
    font/ttf
    font/otf
    font/woff
    font/woff2;

server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # Asset-urile hashate (Vite le pune in /assets/) pot fi cache-uite forever.
    location /assets/ {
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Fonturile KaTeX si alte fisiere statice cu extensii imutabile.
    location ~* \.(?:woff2?|ttf|otf|eot|ico|png|jpg|jpeg|gif|svg|webp)$ {
        access_log off;
        add_header Cache-Control "public, max-age=2592000";
        try_files $uri =404;
    }

    # index.html NU trebuie cache-uit, altfel clientii raman pe versiuni vechi.
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy catre backend
    # resolver 127.0.0.11 = DNS intern Docker; upstream ca variabila =>
    # nginx rezolva per-request, nu la startup.
    location /api/ {
        resolver 127.0.0.11 valid=30s;
        set $backend http://${BACKEND_HOST}:9090;
        proxy_pass $backend/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
